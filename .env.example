# Optional environment variables. Set only the values you want to override.
# This file is a reference; the server does not automatically load .env files.
# Export variables in your shell or set them in your MCP client's environment.

# FLOW_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# CHROME_PATH=/absolute/path/to/chrome
# FLOW_DATA_DIR=/absolute/path/to/flow-data
# FLOW_PROFILE_DIR=/absolute/path/to/flow-data/browser-profile
# FLOW_STATE_FILE=/absolute/path/to/flow-data/state.json
# FLOW_DATABASE_FILE=/absolute/path/to/flow-data/state.sqlite
# FLOW_DOWNLOAD_DIR=/absolute/path/to/flow-data/downloads
# FLOW_FFPROBE_EXECUTABLE=/absolute/path/to/ffprobe
